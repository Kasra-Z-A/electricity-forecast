FROM public.ecr.aws/lambda/python:3.12
# Patch the OS packages the base layer ships with.
RUN dnf upgrade -y && dnf clean all
RUN pip install --no-cache-dir uv==0.12.10
# Chronos-2 weights at the pinned revision, checked against their SHA-256 before use.
ARG CHRONOS_REVISION=29ec3766d36d6f73f0696f85560a422f50e8498c
ENV CHRONOS_MODEL_DIR=/opt/chronos-2-${CHRONOS_REVISION}
RUN mkdir -p "$CHRONOS_MODEL_DIR" && cd "$CHRONOS_MODEL_DIR" \
 && base="https://huggingface.co/amazon/chronos-2/resolve/${CHRONOS_REVISION}" \
 && curl -fsSL --retry 5 -o config.json "$base/config.json" \
 && curl -fsSL --retry 5 -o model.safetensors "$base/model.safetensors" \
 && printf '%s  %s\n' \
      ef1143bfdc9c0376d9a056eefca46cb4b1ec3d0ffacd541ff56feb40fb708031 config.json \
      ddcda3c7508bf2528087723e98a20707cc04b7f370ae275a9fd88078ddba4f42 model.safetensors \
    | sha256sum -c -
COPY pyproject.toml uv.lock README.md /build/
COPY src /build/src
# Lambda imports from LAMBDA_TASK_ROOT, so dependencies and the package are
# installed there from the lock file rather than into a virtual environment.
RUN cd /build \
 && uv export --locked --no-dev --group cloud --group research --group foundation --no-emit-project -o requirements.txt \
 && uv pip install --python /var/lang/bin/python3.12 --target "$LAMBDA_TASK_ROOT" -r requirements.txt \
 && uv pip install --python /var/lang/bin/python3.12 --target "$LAMBDA_TASK_ROOT" --no-deps . \
 && rm -rf /build /root/.cache
# Forecast artifacts record the lock file's hash, read from the working directory.
COPY uv.lock ${LAMBDA_TASK_ROOT}/
CMD ["power_forecast.cloud.handler"]
